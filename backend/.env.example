# ===== $BULLPOST rewards bot configuration =====
# Copy to .env and fill in. NEVER commit .env.

# Solana RPC endpoint. api.mainnet-beta.solana.com rate-limits hard (429s under
# any burst). https://solana-rpc.publicnode.com is free, needs no key, and
# handles the engine fine (verified). A paid Helius/QuickNode endpoint is best
# for heavy, sustained spamming.
RPC_URL=https://solana-rpc.publicnode.com

# The CREATOR wallet secret key — the wallet that launched $BULLPOST and
# accrues creator rewards. Base58 string (Phantom export) or JSON byte array.
CREATOR_WALLET_SECRET=

# The official $BULLPOST mint address (set after launch). Optional — only
# used to stamp the official CA into each spam pair's metadata.
BULLPOST_MINT=

# Where the 50% bagworker bucket gets sent (a wallet you control, or pay the
# bagworkers directly from it).
BAGWORKER_WALLET=

# ---- behavior ----
# Dry run: log everything, sign nothing, send nothing. Flip to false to go live.
DRY_RUN=true

# Run a cycle every N minutes when started with --loop
CYCLE_MINUTES=30

# Don't act on the rewards bucket until at least this much SOL is claimable/accrued
MIN_CYCLE_SOL=0.05

# Always leave this much SOL in the creator wallet for rent + tx fees
RESERVE_SOL=0.05

# ---- pair spam (50% bucket) ----
# Optional dev-buy (SOL) to seed each new billboard's curve. 0 = create-only
# (creation costs ~0.02 SOL rent+fees regardless). A dev buy is sent as a
# separate tx after the create, since pump.fun/PumpPortal reject atomic create+buy.
SPAM_DEV_BUY_SOL=0
# Hard cap on launches per cycle, however big the bucket gets
SPAM_MAX_LAUNCHES_PER_CYCLE=3
# Path to the mascot image used for spam-pair metadata
SPAM_IMAGE_PATH=../assets/logo.png
# Name/ticker stamped on every billboard launch
SPAM_TOKEN_NAME=$BULLPOST
SPAM_TOKEN_SYMBOL=BULLPOST
# Metadata for the billboards. Two ways to supply it:
#  (A) SPAM_METADATA_URI — reuse an already-pinned metadata JSON (no key needed).
#      Easiest: point at your official $BULLPOST coin's metadata URI.
#  (B) PINATA_JWT — free at pinata.cloud; the bot pins the logo + JSON itself.
#      (pump.fun's own upload endpoint was discontinued.)
# If SPAM_METADATA_URI is set it wins and PINATA_JWT is not needed.
SPAM_METADATA_URI=
PINATA_JWT=
# Website printed in every spam pair's metadata (used only when pinning via Pinata)
OFFICIAL_WEBSITE=https://bullpost.fun
OFFICIAL_TWITTER=
OFFICIAL_TELEGRAM=

# Slippage (basis points) for the optional spam dev-buy
SLIPPAGE_BPS=300

# ---- throttled spam engine (npm run spam) ----
# Pairs per burst, and the cadence bounds. The interval starts at MIN when the
# wallet is flush and stretches toward MAX as funds drain (auto slowdown).
SPAM_BURST_SIZE=3
SPAM_MIN_INTERVAL_SEC=5
SPAM_MAX_INTERVAL_SEC=120
# Run full speed while the wallet can still afford at least this many pairs.
SPAM_FULL_SPEED_RUNWAY=25
# Re-claim creator fees this often during a run, to refill the runway.
SPAM_CLAIM_EVERY_SEC=300
